# Copy this file to .env and fill in your Firebase credentials
# Do NOT commit your real .env with secret keys to version control.

# Firebase API key (required)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Realtime Database URL (optional - defaults are provided in code)
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Role token signing secret (used to generate/verify role tokens 'rt' in URLs)
# NOTE: For production do NOT expose secrets in client bundles. Prefer generating tokens on a secure server.
REACT_APP_ROLE_SECRET=your_role_secret_here
REACT_APP_API_KEY=your_secure_access_key_here